DEVICE="/dev/ttyACM0"
FC_DEVICE="/dev/serial0"
FC_BAUDRATE="115200"
# Tuned for the Pi 1 Model B+ (single core ARMv6, 512 MB).
# On a Pi 3 B+ or newer, 640x480 at 20 fps and 4 clients are comfortable.
CAMERA_ENABLED="true"
CAMERA_WIDTH="320"
CAMERA_HEIGHT="240"
CAMERA_FRAMERATE="10"
CAMERA_JPEG_QUALITY="75"
CAMERA_MAX_CLIENTS="2"
# auto | hardware | software - auto prefers the VideoCore JPEG encoder.
CAMERA_ENCODER="auto"
CAMERA_BUFFER_COUNT="2"

# Postgres on AWS RDS - the instance terraformed in r2d2-infrastructure
# (aws_db_instance.rover: postgres 16, db "rover", user "rover", eu-central-1).
# Leave DATABASE_URL empty to run with no database at all: lib.db reports
# itself as not configured and nothing else in the vehicle changes.
#
# The instance is publicly_accessible = false and its security group only
# admits the app security group, so this URL resolves but does not connect
# from outside the VPC - see README section 6 for the access path.
# DATABASE_URL="postgresql+psycopg://rover:<password>@rover-db.<id>.eu-central-1.rds.amazonaws.com:5432/rover"
DATABASE_URL=""
DB_SSLMODE="require"
# Path to the RDS CA bundle; required when DB_SSLMODE is verify-full.
# curl -o rds-eu-central-1-bundle.pem \
#   https://truststore.pki.rds.amazonaws.com/eu-central-1/eu-central-1-bundle.pem
DB_SSLROOTCERT=""
DB_CONNECT_TIMEOUT="5"
DB_STATEMENT_TIMEOUT_MS="5000"
DB_POOL_SIZE="2"
DB_MAX_OVERFLOW="0"
DB_POOL_RECYCLE="300"
DB_ECHO="false"
